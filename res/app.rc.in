#include <windows.h>

1 ICON "@KD_RES_DIR@/app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@KD_RES_DIR@/app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @KD_VER_COMMA@
 PRODUCTVERSION @KD_VER_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Kanban Desktop"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "KanbanDesktop"
      VALUE "OriginalFilename", "KanbanDesktop.exe"
      VALUE "ProductName", "Kanban Desktop"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
